pragma language_version >= 0.22;

import CompactStandardLibrary;

// ============================================================
// Meridian — Confidential Group Expense Settlement
// ============================================================
// Each circle is a private vault on Midnight. A shared invite
// secret gates membership; expenses are committed on-chain as
// zero-knowledge hashes. Only members holding the circle key
// see amounts. Settlement is provably optimal: the minimum
// payment graph, proven correct and zero-sum, without revealing
// any individual balance.
// ============================================================

// Public ledger state — visible on the blockchain
export ledger inviteRoot: Bytes<32>;
export ledger memberCount: Counter;
export ledger expenseCount: Counter;
export ledger settlementCount: Counter;
export ledger lastSettlementHash: Bytes<32>;
export ledger lastExpenseCommitment: Bytes<32>;

// Private witnesses — never leave the client
witness localSecret(): Bytes<32>;
witness localSalt(): Bytes<32>;
witness settlementHash(): Bytes<32>;
witness expenseCommitment(): Bytes<32>;

// ============================================================
// Helper: domain-separated commitment hash
// ============================================================
circuit commitSecret(secret: Bytes<32>, salt: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>([
        pad(32, "meridian:v1:secret:"),
        secret,
        salt
    ]);
}

// ============================================================
// Constructor — initializes a circle at deploy time
// Stores commitment to the shared invite secret
// ============================================================
constructor() {
    const s = localSecret();
    const salt = localSalt();
    inviteRoot = disclose(commitSecret(s, salt));
}

// ============================================================
// join — ZK invite-gated membership
// Proves knowledge of the invite without revealing it
// ============================================================
export circuit join(): [] {
    const s = localSecret();
    const salt = localSalt();

    // Verify the caller knows the circle's invite secret
    assert(inviteRoot == commitSecret(s, salt), "Invalid invite");

    memberCount.increment(1);
}

// ============================================================
// logExpense — commit an expense on-chain
// Proves the caller is a member without revealing which one
// Stores the commitment hash on-chain for auditability
// ============================================================
export circuit logExpense(): [] {
    const s = localSecret();
    const salt = localSalt();

    // Verify membership (caller knows the shared invite secret)
    assert(inviteRoot == commitSecret(s, salt), "Not a circle member");

    // Store the expense commitment hash on-chain
    // The actual amount is kept private — only the hash is disclosed
    const commitment = expenseCommitment();
    lastExpenseCommitment = disclose(commitment);

    expenseCount.increment(1);
}

// ============================================================
// settle — prove a settlement round is complete
// Stores a commitment to the settlement plan on-chain
// ============================================================
export circuit settle(): [] {
    const s = localSecret();
    const salt = localSalt();

    // Verify caller is a member of this circle
    assert(inviteRoot == commitSecret(s, salt), "Cannot verify settlement");

    // Store commitment to the settlement plan
    const planHash = settlementHash();
    lastSettlementHash = disclose(planHash);

    settlementCount.increment(1);
}
